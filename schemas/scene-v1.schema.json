{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tomo:scene:1",
  "title": "Tomo headless scene v1",
  "$comment": "Structural schema. tomo scene validate additionally enforces UTF-8 byte limits, unique IDs, references, unit quaternions, velocity norms, static-body rules and physics construction. JSON Schema alone is not full validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "name", "gravity", "fixed_dt", "bodies"],
  "properties": {
    "schema_version": {"const": 1},
    "revision": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "name": {"type": "string", "minLength": 1, "maxLength": 256},
    "gravity": {"$ref": "#/$defs/vector3"},
    "fixed_dt": {"type": "number", "minimum": 0.000002, "maximum": 0.25},
    "bodies": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/body"}},
    "checks": {"type": "array", "maxItems": 512, "default": [], "items": {"$ref": "#/$defs/check"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$"},
    "vector3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "quaternion": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": -1, "maximum": 1}, "default": [0, 0, 0, 1]},
    "shape": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "radius"], "properties": {"type": {"const": "sphere"}, "radius": {"type": "number", "minimum": 0.0001, "maximum": 10000}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "half_extents"], "properties": {"type": {"const": "box"}, "half_extents": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0.0001, "maximum": 10000}}}}
      ]
    },
    "body": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "motion", "shape", "position"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "motion": {"enum": ["static", "kinematic", "dynamic"]},
        "shape": {"$ref": "#/$defs/shape"},
        "position": {"$ref": "#/$defs/vector3"},
        "rotation": {"$ref": "#/$defs/quaternion"},
        "mass": {"type": "number", "minimum": 0.000001, "maximum": 1000000000, "default": 1},
        "linear_velocity": {"$ref": "#/$defs/vector3", "default": [0, 0, 0]},
        "angular_velocity": {"$ref": "#/$defs/vector3", "default": [0, 0, 0]},
        "friction": {"type": "number", "minimum": 0, "maximum": 100, "default": 0.5},
        "restitution": {"type": "number", "minimum": 0, "maximum": 1, "default": 0},
        "is_sensor": {"type": "boolean", "default": false},
        "allow_sleep": {"type": "boolean", "default": true}
      }
    },
    "check": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "body", "min", "max"], "properties": {"kind": {"const": "position"}, "body": {"$ref": "#/$defs/id"}, "min": {"$ref": "#/$defs/vector3"}, "max": {"$ref": "#/$defs/vector3"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "body", "max"], "properties": {"kind": {"const": "speed"}, "body": {"$ref": "#/$defs/id"}, "max": {"type": "number", "minimum": 0, "maximum": 1000000}}}
      ]
    }
  }
}
