{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "urn:tomo:code-edit:1",
  "title": "Tomo Rust source edit v1",
  "required": [
    "schema_version",
    "request_id",
    "path",
    "expected_sha256",
    "content"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "path": {
      "type": "string",
      "pattern": "^examples/rust_game/src/[^.][A-Za-z0-9_/-]*\\.rs$"
    },
    "expected_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content": {
      "type": "string",
      "maxLength": 262144
    }
  }
}
