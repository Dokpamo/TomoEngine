{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dokpamo/TomoEngine/schemas/replay-v1.schema.json",
  "title": "Box Run fixed-tick input replay v1",
  "description": "The tool additionally enforces a 1 MiB file limit and 36000 total ticks. Replays always start in a fresh built-in Box Run level.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "segments", "expect_win"],
  "properties": {
    "schema_version": { "const": 1 },
    "expect_win": { "type": "boolean" },
    "segments": {
      "type": "array", "minItems": 1, "maxItems": 1024,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["ticks", "input"],
        "properties": {
          "ticks": { "type": "integer", "minimum": 1, "maximum": 36000 },
          "input": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "up": { "type": "boolean", "default": false },
              "down": { "type": "boolean", "default": false },
              "left": { "type": "boolean", "default": false },
              "right": { "type": "boolean", "default": false }
            }
          }
        }
      }
    }
  }
}
