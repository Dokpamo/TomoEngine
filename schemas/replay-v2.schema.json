{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tomo:replay:2",
  "title": "Tomo game input replay v2",
  "description": "Direction and Space/action input for the selected project or built-in game. 1 MiB, 1024 segments, 36000 total ticks, 5000000 body-squared work and 5000000 rule work limits are checked before mutation. expect_win=false accepts any non-winning status; inspect status and score for exact assertions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "segments",
    "expect_win"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "expect_win": {
      "type": "boolean"
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ticks",
          "input"
        ],
        "properties": {
          "ticks": {
            "type": "integer",
            "minimum": 1,
            "maximum": 36000
          },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "up": {
                "type": "boolean",
                "default": false
              },
              "down": {
                "type": "boolean",
                "default": false
              },
              "left": {
                "type": "boolean",
                "default": false
              },
              "right": {
                "type": "boolean",
                "default": false
              },
              "action": {
                "type": "boolean",
                "default": false
              }
            }
          }
        }
      }
    }
  }
}
