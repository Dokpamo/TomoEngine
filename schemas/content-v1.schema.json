{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tomo:content:1",
  "title": "Tomo content v1",
  "$comment": "Rust checks hierarchy cycles, references, combined transforms, projection validity and exact byte/work budgets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entities",
    "cameras",
    "active_camera",
    "default_hud",
    "ui",
    "sounds"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "cameras": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "eye",
          "target",
          "up",
          "vertical_fov_degrees",
          "near",
          "far",
          "follow"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "eye": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": -10000,
              "maximum": 10000
            }
          },
          "target": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": -10000,
              "maximum": 10000
            }
          },
          "up": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            }
          },
          "vertical_fov_degrees": {
            "type": "number",
            "minimum": 5,
            "maximum": 150
          },
          "near": {
            "type": "number",
            "minimum": 0.001,
            "maximum": 100
          },
          "far": {
            "type": "number",
            "minimum": 0.001,
            "maximum": 30000
          },
          "follow": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "minItems": 1,
      "maxItems": 16
    },
    "active_camera": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "default_hud": {
      "type": "boolean"
    },
    "ui": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "position",
          "size",
          "text",
          "color",
          "background",
          "visibility"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "kind": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "label"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "score"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "timer"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "status"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "max_score"
                ],
                "properties": {
                  "type": {
                    "const": "progress"
                  },
                  "max_score": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "action"
                ],
                "properties": {
                  "type": {
                    "const": "button"
                  },
                  "action": {
                    "enum": [
                      "restart",
                      "pause",
                      "resume",
                      "save",
                      "load",
                      "next_scene"
                    ]
                  }
                }
              }
            ]
          },
          "position": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "size": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "text": {
            "type": "string",
            "maxLength": 48,
            "pattern": "^[A-Z0-9 .:/+\\-]*$"
          },
          "color": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "background": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "visibility": {
            "enum": [
              "always",
              "ready",
              "playing",
              "paused",
              "won",
              "lost"
            ]
          }
        }
      },
      "minItems": 0,
      "maxItems": 32
    },
    "sounds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "trigger",
          "frequency",
          "seconds",
          "volume"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "trigger": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "start"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "score"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "won"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "lost"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "id"
                ],
                "properties": {
                  "type": {
                    "const": "rule"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,64}$"
                  }
                }
              }
            ]
          },
          "frequency": {
            "type": "number",
            "minimum": 20,
            "maximum": 12000
          },
          "seconds": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 5
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "minItems": 0,
      "maxItems": 32
    }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "parent",
        "body",
        "transform",
        "visual",
        "spin_degrees_per_second",
        "tags"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "parent": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "body": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "transform": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "position",
            "rotation",
            "scale"
          ],
          "properties": {
            "position": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              }
            },
            "rotation": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              }
            },
            "scale": {
              "type": "number",
              "minimum": 0.001,
              "maximum": 100
            }
          }
        },
        "visual": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "shape",
                "color",
                "visible"
              ],
              "properties": {
                "shape": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type",
                        "half_extents"
                      ],
                      "properties": {
                        "type": {
                          "const": "box"
                        },
                        "half_extents": {
                          "type": "array",
                          "minItems": 3,
                          "maxItems": 3,
                          "items": {
                            "type": "number",
                            "minimum": 0.0001,
                            "maximum": 10000
                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type",
                        "radius"
                      ],
                      "properties": {
                        "type": {
                          "const": "sphere"
                        },
                        "radius": {
                          "type": "number",
                          "minimum": 0.0001,
                          "maximum": 10000
                        }
                      }
                    }
                  ]
                },
                "color": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "visible": {
                  "type": "boolean"
                }
              }
            }
          ]
        },
        "spin_degrees_per_second": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": -360,
            "maximum": 360
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "minItems": 0,
          "maxItems": 8
        }
      }
    }
  }
}
